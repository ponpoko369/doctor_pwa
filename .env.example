# P1 WhatsApp 봇용 환경변수 — Vercel Project Settings → Environment Variables 에 그대로 입력.
# 로컬 개발 시에는 `vercel env pull` 로 .env.local 받아오는 걸 권장 (Git에는 절대 커밋 금지).

# Anthropic (기존 translate.js 에서 이미 사용 중)
ANTHROPIC_API_KEY=sk-ant-...

# Meta WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=clinica_demo_2026_xyz

# Supabase
SUPABASE_URL=https://cojzdjajwrzzyqxzljgq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# P2 — MCP server + Claude connector
# CLINICA_MCP_URL is where the deployed /api/mcp endpoint is reachable from
# Anthropic's servers. Same Vercel project, so just the public URL.
CLINICA_MCP_URL=https://doctorpwa.vercel.app/api/mcp
# MCP_AUTH_TOKEN is a shared secret between the webhook (which puts it in
# Claude's mcp_servers config) and the MCP endpoint (which checks the
# Authorization header). Generate with: openssl rand -base64 32
MCP_AUTH_TOKEN=
